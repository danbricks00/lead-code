{
  "name": "lead-code",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vercel dev",
    "smoke": "node scripts/smoke-test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "mkdir -p public && cp -r src/web/pages/* public/ && (test -f src/web/pages/frontend.html && cp src/web/pages/frontend.html public/index.html || true)",
    "deploy": "node scripts/deploy-and-commit.js",
    "deploy:git-only": "node scripts/deploy-and-commit.js git-only",
    "deploy:vercel-only": "node scripts/deploy-and-commit.js vercel-only",
    "deploy:both": "node scripts/deploy-and-commit.js both",
    "deploy:simple": "npx vercel --prod",
    "commit": "git add . && git commit -m \"Update: $(date)\" && git push",
    "auto-save": "node scripts/auto-save.js"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "googleapis": "^154.1.0",
    "html-to-docx": "^1.8.0",
    "nodemailer": "^7.0.5",
    "puppeteer": "^23.0.0",
    "resend": "^3.1.0"
  }
}
