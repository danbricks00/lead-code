{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "New--tradewebsite-code/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/test-zone-sheet-structure.html",
      "dest": "/test-zone-sheet-structure.html"
    },
    {
      "src": "/debug-zone-api.html",
      "dest": "/debug-zone-api.html"
    },
    {
      "src": "/(.*)",
      "dest": "/New--tradewebsite-code/$1"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  }
} 